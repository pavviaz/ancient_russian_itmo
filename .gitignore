## Birchbark OCR repo — what *not* to commit.
## Curated to keep the repo lean (code + small data manifests + paper artifacts)
## while excluding model weights, virtualenvs, raw scrape images, and exploration figures.

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Virtual envs (regenerate from envs/freeze_*.txt) ----------------------
.venv/
.venv-*/
venv/
env/
envs/build/

# --- Top-level scratch files (superseded by curated scripts/) --------------
qwen2.5vl_oldrus_v2.py

# --- Experiment runs / model artefacts -------------------------------------
runs/
wandb/
logs/
lora-out/
outputs/
checkpoints/
nohup.out
*.nohup.out

# Generic large binary weights — never commit
*.pt
*.bin
*.safetensors
*.ckpt
*.pth
*.onnx

# Generic archive blobs (e.g. dataset_a.zip — 4.7 GB at top level)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Generic non-source binaries
*.pdf

# --- Data: raw downloads (regenerated by scrape scripts; manifests are kept)
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.png
data/raw/**/*.gif
data/raw/**/*.webp
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.html
data/raw/**/*.htm
data/raw/**/*.txt
# Per-document meta.json files duplicate manifest.jsonl rows; drop them
data/raw/gramoty/documents/**/meta.json
# But keep top-level manifests / splits / index files
!data/raw/**/manifest.jsonl
!data/raw/**/document_index.jsonl
!data/raw/.gitkeep

# --- Data: interim derivations (regenerated by scripts/crop_*.py & render_*.py)
data/interim/**/*.png
data/interim/**/*.jpg
data/interim/**/*.jpeg
data/interim/**/*.gif
data/interim/**/*.webp
data/interim/**/*.txt
# Keep small jsonl labels and policy docs
!data/interim/**/*.jsonl
!data/interim/**/*.md
!data/interim/.gitkeep

# --- Data: processed (most are regenerable; keep the small manifests) ------
# Unified OCR images (dataset blobs)
data/processed/unified_ocr/images/
data/processed/unified_ocr_smoke/

# Synth carved (deterministic engraver outputs — large PNG set)
data/processed/synth_carved/**/carved/
data/processed/synth_carved/**/gold/
data/processed/synth_carved/**/*.png
data/processed/synth_carved/**/*.jpg
# Keep the small reproducibility manifests / config
!data/processed/synth_carved/**/manifest.jsonl
!data/processed/synth_carved/**/summary.json

# Synth Kandinsky-refined (large PNG set)
data/processed/synth_kandinsky/**/refined/
data/processed/synth_kandinsky/**/raw/
data/processed/synth_kandinsky/**/*.png
data/processed/synth_kandinsky/**/*.jpg
# Keep manifests + audit summaries
!data/processed/synth_kandinsky/**/manifest.jsonl
!data/processed/synth_kandinsky/**/manifest_audit.jsonl
!data/processed/synth_kandinsky/**/manifest_clean.jsonl
!data/processed/synth_kandinsky/**/audit_summary.json

# Qwen-clean-bark substrates (large PNG set)
data/processed/qwen_clear_gramoty/**/*.png
data/processed/qwen_clear_gramoty/**/*.jpg
data/processed/qwen_clear_gramoty/**/images/
!data/processed/qwen_clear_gramoty/**/manifest.jsonl

# Earlier (superseded) phase4 split iterations — keep only phase4_v3 (canonical)
data/splits/phase4/
data/splits/phase4_v2/
# (data/splits/phase4_v3/ is the published mix-pool set — kept by default)

# Keep the tiny per-split jsonl indexes everywhere else
!data/processed/**/*.jsonl

# --- Data: synthetic (legacy; replaced by data/processed/synth_*) ----------
data/synthetic/**/*.png
data/synthetic/**/*.jpg
data/synthetic/**/*.jpeg
data/synthetic/**/*.txt
!data/synthetic/**/*.jsonl
!data/synthetic/**/*.md

# --- Reports figures: ignore *exploration* sweeps; keep paper-ready figs ----
reports/figs/**
!reports/figs/
!reports/figs/.gitkeep
!reports/figs/**/*.md
# Force-include: paper-ready figures used by FINDINGS_for_paper.md
!reports/figs/findings/
!reports/figs/findings/**

# --- Reports: keep evals + audit (paper-essential), drop big symbol_audit --
# reports/audit/ contains the dataset_a audit grids referenced by FINDINGS §3.4
reports/symbol_audit/

# --- Notebooks: ignore the large exploration ones; keep the two referenced --
# Big notebooks with embedded image outputs (exploration logs)
notebooks/openrouter_gpt_image_carving_quality.ipynb
notebooks/qwen_image_edit_bark_carving.ipynb
notebooks/qwen_synth_enhancement.ipynb
notebooks/openai_gpt_image_carving_quality.ipynb
# Keep:
#   notebooks/qwen_image_edit_bark_clearing.ipynb  (FINDINGS §3 stage 1)
#   notebooks/kandinsky_synth_refine.ipynb         (FINDINGS §3 stage 3)

# --- IDE / OS / agent artifacts --------------------------------------------
.env
.env.*
.DS_Store
.idea/
.vscode/
.cursor/
terminals/
Untitled
Untitled-*
*.swp
*.swo
.ipynb_checkpoints/
