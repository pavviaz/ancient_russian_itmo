# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# --- Virtual envs ---------------------------------------------------------- (regenerated on new machine via setup scripts)
.venv/
.venv-churro-paddle/
.venv-sdxl/
venv/
envs/build/

# --- Experiment runs / model artefacts ------------------------------------
runs/
wandb/
logs/
lora-out/
outputs/
checkpoints/

# Generic large binary weights — never commit
*.pt
*.bin
*.safetensors
*.ckpt
*.pth
*.onnx
*.zip
*.tar
*.tar.gz
*.tgz

# --- Data: raw downloads --------------------------------------------------- (regenerated by scrape scripts; manifests are kept)
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.png
data/raw/**/*.gif
data/raw/**/*.webp
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.html
data/raw/**/*.htm
data/raw/**/*.txt
# Per-document meta.json files duplicate manifest.jsonl rows; drop them.
data/raw/gramoty/documents/**/meta.json
# But keep top-level manifests / splits / index files
!data/raw/**/manifest.jsonl
!data/raw/**/document_index.jsonl
!data/raw/.gitkeep

# --- Data: interim derivations -------------------------------------------- (regenerated by scripts/crop_*.py & scripts/render_*.py)
data/interim/**/*.png
data/interim/**/*.jpg
data/interim/**/*.jpeg
data/interim/**/*.gif
data/interim/**/*.webp
# Per-sample gold/README .txt files are paired with the (gitignored) images and
# are regenerated by the synth/crop scripts — drop them too.
data/interim/**/*.txt
# Keep small jsonl labels and policy docs
!data/interim/**/*.jsonl
!data/interim/**/*.md
!data/interim/.gitkeep

# --- Data: processed (unified OCR dataset) -------------------------------- (regenerated by scripts/build_unified_ocr_dataset.py)
data/processed/unified_ocr/images/
data/processed/unified_ocr_smoke/
# Keep the tiny per-split jsonl indexes
!data/processed/unified_ocr/*.jsonl

# --- Data: synthetic -------------------------------------------------------
data/synthetic/**/*.png
data/synthetic/**/*.jpg
data/synthetic/**/*.jpeg
data/synthetic/**/*.txt
!data/synthetic/**/*.jsonl
!data/synthetic/**/*.md

# --- Reports figures (regenerable, large/noisy) ----------------------------
reports/figs/**
!reports/figs/
!reports/figs/.gitkeep
!reports/figs/**/*.md

# --- IDE / OS --------------------------------------------------------------
.env
.env.*
.DS_Store
.idea/
.vscode/
Untitled
